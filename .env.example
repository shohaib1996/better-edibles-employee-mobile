# Copy to .env and set the backend address. Never commit .env.
# Phone on the same Wi-Fi as your computer: use the computer's LAN IP, not localhost.
#   e.g. EXPO_PUBLIC_API_BASE_URL=http://192.168.1.20:3001
# Release builds must use HTTPS.
# The app only talks to the Better Edibles backend; the backend reaches
# Accounting (https://api-accounting.better-edibles.com) server-side.
EXPO_PUBLIC_API_BASE_URL=https://api-backend.better-edibles.com
