{
  "expo": {
    "name": "Better Edibles Employee",
    "slug": "better-edibles-employee",
    "scheme": "betteredibles",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.betteredibles.employee"
    },
    "android": {
      "package": "com.betteredibles.employee",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#fff8ec"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#fff8ec"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Better Edibles uses the microphone to record voice notes for your delivery stops."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Better Edibles checks your location once when you clock in or out. Never in the background."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Better Edibles uses your photos so you can upload a signed form or a photo of your permit.",
          "cameraPermission": "Better Edibles uses the camera so you can take a photo of a signed form or your permit."
        }
      ],
      "expo-asset"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "cfbfe844-8423-4e8d-a0c9-65fc9c3c7a19"
      }
    },
    "owner": "shohaib123"
  }
}
